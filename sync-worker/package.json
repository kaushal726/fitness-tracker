{
  "name": "eatright-sync",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EatRight sync API: one Cloudflare Worker + one D1 database (free plan).",
  "scripts": {
    "dev": "wrangler dev --local --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply eatright-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply eatright-sync --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.20",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
